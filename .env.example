# Port for the server (defaults to 3000)
PORT=3000

# Gemini API key for server-side evaluation and rewriting
GEMINI_API_KEY=

# Optional model preference override (comma-separated, e.g. gemini-3.8-flash,gemini-3.7-flash)
GEMINI_MODEL=

# Rate limits
RATE_LIMIT_PER_HOUR=40
DAILY_REQUEST_CAP=2000

# Trust proxy hops behind reverse proxy
TRUST_PROXY_HOPS=1
